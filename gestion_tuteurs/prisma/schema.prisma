generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase expose deux acces :
  //  - url       : le pooler (pgBouncer, port 6543) pour les requetes de l'app
  //  - directUrl : la connexion directe (port 5432) pour les migrations, qui
  //                ont besoin de transactions que le pooler ne permet pas
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         Role   @default(STUDENT)

  lastName  String
  firstName String
  gender    String?
  phone     String?
  whatsapp  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor        Tutor?
  student      Student?
  requests     Request[]
  reviewsGiven Review[]  @relation("ReviewAuthor")

  @@map("users")
}

model Tutor {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id])

  bio          String? @db.Text
  photo        String?
  locationMap  String?
  city         String?
  district     String?
  availability String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  assignments TeachingAssignment[]
  applications TutorApplication[]
  contracts   Contract[]
  reviews     Review[]             @relation("ReviewTutor")

  @@map("tutors")
}

model Student {
  userId  Int     @id
  user    User    @relation(fields: [userId], references: [id])
  levelId Int?
  level   Level?  @relation(fields: [levelId], references: [id])
  school  String?

  @@map("students")
}

model Level {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  cycle     String?
  sortOrder Int     @default(0)

  students    Student[]
  requests    Request[]
  assignments TeachingAssignment[]

  @@map("levels")
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  assignments TeachingAssignment[]
  requests    Request[]

  @@map("subjects")
}

model TeachingAssignment {
  id        Int     @id @default(autoincrement())
  tutorId   Int
  subjectId Int
  levelId   Int
  tutor     Tutor   @relation(fields: [tutorId], references: [userId])
  subject   Subject @relation(fields: [subjectId], references: [id])
  level     Level   @relation(fields: [levelId], references: [id])

  @@unique([tutorId, subjectId, levelId])
  @@map("teaching_assignments")
}

enum RequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum TutorApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  DUE
  PAID
  CANCELLED
}

model Request {
  id              Int           @id @default(autoincrement())

  studentId       Int
  student         User          @relation(fields: [studentId], references: [id])

  levelId         Int
  level           Level         @relation(fields: [levelId], references: [id])

  subjectId       Int
  subject         Subject       @relation(fields: [subjectId], references: [id])

  preferredGender String?
  preferredPlace  String?
  preferredDays   String?
  preferredTime   String?
  durationMin     Int?
  offeredAmount   Decimal       @db.Decimal(10, 2)

  status          RequestStatus @default(OPEN)
  createdAt       DateTime      @default(now())

  applications    TutorApplication[]

  @@index([status, createdAt])
  @@map("requests")
}

model TutorApplication {
  id         Int               @id @default(autoincrement())

  requestId  Int
  request    Request           @relation(fields: [requestId], references: [id])

  tutorId    Int
  tutor      Tutor             @relation(fields: [tutorId], references: [userId])

  status     TutorApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?

  contract   Contract?

  @@unique([requestId, tutorId])
  @@index([tutorId, status])
  @@map("applications")
}

model Contract {
  id         Int      @id @default(autoincrement())
  applicationId Int              @unique
  application   TutorApplication @relation(fields: [applicationId], references: [id])
  
  tutorId    Int
  tutor      Tutor    @relation(fields: [tutorId], references: [userId])

  reference      String    @unique
  amount         Decimal   @db.Decimal(10, 2)

  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  plannedLessons Int?
  signedAt       DateTime?

  payments Payment[]

  @@map("contracts")
}

model Payment {
  id         Int           @id @default(autoincrement())
  contractId Int
  contract   Contract      @relation(fields: [contractId], references: [id])
  // Versement partiel ou total impute sur contract.amount.
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(DUE)
  method     String? // "Mobile Money", "Cash"
  paidAt     DateTime?

  @@map("payments")
}

model Review {
  id       Int   @id @default(autoincrement())
  tutorId  Int
  authorId Int
  tutor    Tutor @relation("ReviewTutor", fields: [tutorId], references: [userId])
  author   User  @relation("ReviewAuthor", fields: [authorId], references: [id])

  rating    Int // 1..5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([tutorId, authorId])
  @@map("reviews")
}
